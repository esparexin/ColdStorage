{
  "name": "@cold-storage/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run --fileParallelism=false",
    "migrate:free-text-chamber": "node --experimental-strip-types dist/scripts/migrate-free-text-chamber.js",
    "reset:orphaned-stock": "node --experimental-strip-types dist/scripts/reset-orphaned-stock.js"
  },
  "dependencies": {
    "@cold-storage/contracts": "*",
    "argon2": "^0.41.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^18.0.5",
    "express": "^4.21.1",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.2"
  }
}
