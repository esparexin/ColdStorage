# Cold Storage Management System — environment template
# Copy to .env.local and fill in real values. .env.local is gitignored and must never be committed.
#
# `packages/backend/src/config.ts` loads .env.local at startup with `override: false`, so a real
# environment variable (CI, container runtime, shell export) always takes precedence over this file.
# Every variable listed under a "config.ts" heading below is read through the config singleton.
# Variables marked otherwise are read directly from process.env at the cited call site.

# ─── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Single browser origin allowed for credentialed requests. This is one origin, not a list:
# app.ts passes the value directly to cors({ origin }).
CORS_ORIGIN=http://localhost:3000

# ─── Frontend (packages/frontend/next.config.mjs) ────────────────────────────────
# Base URL of the backend API. The rewrite proxies /api/* here. Defaults to
# http://localhost:4000 when unset.
BACKEND_URL=http://localhost:4000

# ─── Security ───────────────────────────────────────────────────────────────────
# Required in production. Use a long random value (e.g. 64+ random characters).
JWT_SECRET=
ACCESS_TOKEN_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_DAYS=7
# Read directly in middleware/security.middleware.ts, not via config.ts.
ENABLE_HSTS=false

# 64 hex characters (AES-256). Required to run encrypted backups.
# When absent, the backup feature reports itself as not configured and its actions stay disabled.
BACKUP_ENCRYPTION_KEY=

# ─── Datastore ──────────────────────────────────────────────────────────────────
# Required in production. MongoDB Atlas replica set is the canonical datastore.
MONGODB_URI=mongodb://127.0.0.1:27017/cold_storage

# ─── Cache / queue (optional) ───────────────────────────────────────────────────
# Reserved for caching, rate limiting and queue infrastructure only.
# Authentication sessions are NEVER stored here; MongoDB is the sole session SSOT.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS_AUTH=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_WINDOW_MS_MUTATIONS=300000
RATE_LIMIT_MAX_MUTATIONS=5
RATE_LIMIT_WINDOW_MS_GENERAL=60000
RATE_LIMIT_MAX_GENERAL=200

# ─── Brand assets (optional) ────────────────────────────────────────────────────
# Cloudinary connection string (cloudinary://key:secret@cloud). Used for logo upload.
CLOUDINARY_URL=

# ─── Bootstrap super admin (optional, first startup only) ────────────────────────
# Seeds a SUPER_ADMIN only if the username does not already exist. There are no
# built-in default credentials: leave blank to skip seeding.
# Read directly in modules/users/user.repository.ts, not via config.ts.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULLNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_EMPID=
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_FACILITY_IDS=